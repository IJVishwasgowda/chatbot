# ==========================================================
# WhatsApp AI Chatbot Backend Configuration
# ==========================================================

# ----------------- Server Settings -----------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ----------------- Google Gemini AI Agent -----------------
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
ANTIGRAVITY_API_KEY=your_gemini_api_key_here
AGENT_MODEL=gemini-2.5-flash
AGENT_TEMPERATURE=0.7

# ----------------- Messaging Provider -----------------
# Options: "whatsapp" (default Meta Cloud API), "twilio", "green_api", "mock"
MESSAGING_PROVIDER=whatsapp

# ----------------- Meta WhatsApp Cloud API -----------------
# Obtained from Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your_permanent_or_system_user_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here

# Custom secret token you configure in Meta App Webhook settings
VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta App Secret (Optional: for validating X-Hub-Signature-256 HMAC headers)
APP_SECRET=your_meta_app_secret_here
WHATSAPP_API_VERSION=v21.0

# ----------------- Twilio Fallback (Optional) -----------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# ----------------- Green-API Fallback (Optional) -----------------
GREEN_API_INSTANCE_ID=your_instance_id_here
GREEN_API_TOKEN=your_green_api_token_here
GREEN_API_HOST=https://api.green-api.com

# ----------------- Storage & Memory -----------------
DB_PATH=data/conversations.db
MAX_HISTORY_TURNS=20

# ----------------- Resilience & Queue Concurrency -----------------
MAX_QUEUE_SIZE=1000
WORKER_CONCURRENCY=4
HTTP_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
