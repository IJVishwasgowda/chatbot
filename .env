# ==========================================================
# WhatsApp AI Chatbot Backend Configuration
# ==========================================================

# ----------------- Server Settings -----------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ----------------- Google Gemini AI Agent -----------------
# Insert your Gemini API key below (https://aistudio.google.com/)
OPENROUTER_API_KEY=sk-or-v1-25c...e46
AGENT_MODEL=openrouter/free
AGENT_TEMPERATURE=0.7
AGENT_TEMPERATURE=0.7

# ----------------- Messaging Provider -----------------
# Options: "whatsapp" (default Meta Cloud API), "twilio", "green_api", "mock"
MESSAGING_PROVIDER=mock

# ----------------- Meta WhatsApp Cloud API (Optional) -----------------
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=my_whatsapp_webhook_secret_token_123
APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ----------------- Storage & Memory -----------------
DB_PATH=data/conversations.db
MAX_HISTORY_TURNS=20

# ----------------- Resilience & Queue Concurrency -----------------
MAX_QUEUE_SIZE=1000
WORKER_CONCURRENCY=4
HTTP_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
